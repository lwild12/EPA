# Snort 2.9 / Snort 3 compatible example rules for the practice patterns. TEST BEFORE USE: replace $HOME_NET/$EXTERNAL_NET to match your lab.
# Add to local.rules and run:  snort -c /etc/snort/snort.conf -r practice.pcap -A console -q
# (Snort was not installed in the environment where these were written, so they are UNTESTED. Check syntax with `snort -T`.)

# 1. Port scan: many SYNs from one source in a short time
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"EPA possible TCP port scan"; flags:S; detection_filter:track by_src, count 30, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)

# 2. SSH brute force: many new connections to port 22
alert tcp any any -> $HOME_NET 22 (msg:"EPA possible SSH brute force"; flags:S; detection_filter:track by_src, count 10, seconds 60; classtype:attempted-admin; sid:1000002; rev:1;)

# 3. Large outbound transfer: flag long-lived sessions to external hosts (tune to your baseline)
alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"EPA large outbound upload (possible exfiltration)"; flow:to_server,established; dsize:>1000; detection_filter:track by_src, count 300, seconds 60; classtype:policy-violation; sid:1000003; rev:1;)

# 4. ICMP sweep
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"EPA ICMP echo sweep"; itype:8; detection_filter:track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000004; rev:1;)

# 5. Cleartext credentials
alert tcp any any -> $HOME_NET [21,23,110] (msg:"EPA cleartext login protocol"; flow:to_server,established; content:"PASS "; nocase; classtype:policy-violation; sid:1000005; rev:1;)
